{
  "framework": "create-react-app",
  "outputDirectory": "build",
  "regions": [
    "iad1"
  ],
  "github": {
    "silent": true,
    "autoAlias": true
  },
  "buildCommand": "npm run build",
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/guide/sitemap.xml",
      "destination": "https://benchlot-web.vercel.app/sitemap.xml"
    },
    {
      "source": "/guide",
      "destination": "https://benchlot-web.vercel.app/guide"
    },
    {
      "source": "/guide/:path*",
      "destination": "https://benchlot-web.vercel.app/guide/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://benchlot-web.vercel.app/_next/:path*"
    }
  ]
}