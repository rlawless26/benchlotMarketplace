{
  "framework": "create-react-app",
  "outputDirectory": "build",
  "regions": [
    "iad1"
  ],
  "github": {
    "silent": true,
    "autoAlias": true
  },
  "buildCommand": "npm run build && mv build/index.html build/app.html",
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?benchfind\\.com"
        }
      ],
      "destination": "https://benchlot.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "https://benchlot-web.vercel.app/api/v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://benchlot-web.vercel.app/api/v1/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://benchlot-web.vercel.app/mcp"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://benchlot-web.vercel.app/mcp/:path*"
    },
    {
      "source": "/developers",
      "destination": "https://benchlot-web.vercel.app/developers"
    },
    {
      "source": "/developers/:path*",
      "destination": "https://benchlot-web.vercel.app/developers/:path*"
    },
    {
      "source": "/api/alerts",
      "destination": "https://benchlot-web.vercel.app/api/alerts"
    },
    {
      "source": "/api/search",
      "destination": "https://benchlot-web.vercel.app/api/search"
    },
    {
      "source": "/api/search/:path*",
      "destination": "https://benchlot-web.vercel.app/api/search/:path*"
    },
    {
      "source": "/api/pricestats",
      "destination": "https://benchlot-web.vercel.app/api/pricestats"
    },
    {
      "source": "/api/toolscan",
      "destination": "https://benchlot-web.vercel.app/api/toolscan"
    },
    {
      "source": "/api/toolscan/:path*",
      "destination": "https://benchlot-web.vercel.app/api/toolscan/:path*"
    },
    {
      "source": "/api/leads",
      "destination": "https://benchlot-web.vercel.app/api/leads"
    },
    {
      "source": "/alerts/confirm/:path*",
      "destination": "https://benchlot-web.vercel.app/alerts/confirm/:path*"
    },
    {
      "source": "/alerts/unsubscribe/:path*",
      "destination": "https://benchlot-web.vercel.app/alerts/unsubscribe/:path*"
    },
    {
      "source": "/guide/sitemap.xml",
      "destination": "https://benchlot-web.vercel.app/sitemap.xml"
    },
    {
      "source": "/guide",
      "destination": "https://benchlot-web.vercel.app/guide"
    },
    {
      "source": "/guide/:path*",
      "destination": "https://benchlot-web.vercel.app/guide/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://benchlot-web.vercel.app/_next/:path*"
    },
    {
      "source": "/",
      "destination": "https://benchlot-web.vercel.app/"
    },
    {
      "source": "/scan",
      "destination": "https://benchlot-web.vercel.app/scan"
    },
    {
      "source": "/faq",
      "destination": "https://benchlot-web.vercel.app/faq"
    },
    {
      "source": "/robots.txt",
      "destination": "https://benchlot-web.vercel.app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://benchlot-web.vercel.app/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "https://benchlot-web.vercel.app/llms.txt"
    },
    {
      "source": "/:path((?!static/|api/|_next/).*)",
      "destination": "/app.html"
    }
  ]
}
