# Benchlot Function Environment Variables Example
# Copy this file to .env and fill in the values with your actual credentials.
# .env is gitignored — never commit it.

# ────────────────────────────────────────────────────────────────────
# Stripe — LIVE (used in deployed Cloud Functions)
# ────────────────────────────────────────────────────────────────────
STRIPE_SECRET=sk_live_your_live_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_live_payment_webhook_secret_here
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_live_connect_webhook_secret_here

# ────────────────────────────────────────────────────────────────────
# Stripe — TEST (used automatically when running the Functions emulator
# locally via `npm run serve`. Falls back to live keys above if unset.)
# ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_TEST=sk_test_your_test_secret_here
STRIPE_WEBHOOK_SECRET_TEST=whsec_your_test_payment_webhook_secret_here
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=whsec_your_test_connect_webhook_secret_here

# ────────────────────────────────────────────────────────────────────
# Resend — transactional email
# ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
# Optional overrides — defaults match what's already verified in Resend:
# RESEND_FROM_ADDRESS=Benchlot <notifications@benchlot.com>
# RESEND_REPLY_TO=rob@benchlot.com
# EMAIL_DRY_RUN=true   # set in local dev to skip real sends

# ────────────────────────────────────────────────────────────────────
# Anthropic — for ToolScan
# ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ────────────────────────────────────────────────────────────────────
# HubSpot — for waitlist sync
# ────────────────────────────────────────────────────────────────────
HUBSPOT_API_KEY=your_hubspot_key_here

# ────────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────────
APP_URL=https://benchlot.com
# CAN-SPAM-required mailing address used in email footers:
# BENCHLOT_MAILING_ADDRESS=Benchlot, 123 Main St, Boston, MA 02116
