# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=
# Note: Stripe secret key should only be used in Firebase Functions, not in the front end

# Application Settings
REACT_APP_BASE_URL=http://localhost:3000

# Meta Pixel (Founding Sellers campaign — loaded only on /founding-sellers)
REACT_APP_META_PIXEL_ID=

# HubSpot Forms (Founding Sellers — portal defaults to 396680 if unset)
REACT_APP_HUBSPOT_PORTAL_ID=
REACT_APP_HUBSPOT_FOUNDING_FORM_ID=